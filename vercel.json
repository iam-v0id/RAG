{
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/test", "dest": "/api/test.py" },
    { "src": "/api/search", "dest": "/api/search.py" },
    { "src": "/api/upload", "dest": "/api/upload.py" },
    { "src": "/api/docs", "dest": "/api/docs.py" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    {
      "src": "/(.*.(js|css|svg|png|jpg|jpeg|gif|ico|txt|webp|json))",
      "dest": "/$1"
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
